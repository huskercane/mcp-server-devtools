MCP_AUTH_MODE=oidc
MCP_OIDC_PROFILE=generic
MCP_OIDC_ISSUER=https://issuer.example
MCP_OIDC_AUDIENCE=https://mcp.example:8443
MCP_PUBLIC_URL=https://mcp.example:8443
MCP_OIDC_JWKS_FILE=/jwks/jwks.json
MCP_POLICY_PUBLIC_KEY=replace-with-base64-verifying-key
MCP_REVOCATION_FILE=/policies/revocations.yaml
MCP_AUDIT_SIGNING_KEY=/secrets/audit.key
# For the optional syslog profile, provision your own matching CA/client certs:
# MCP_AUDIT_FORWARD_URL=syslog+tls://syslog:6514
# MCP_AUDIT_FORWARD_CA_FILE=/tls/ca.pem
# MCP_AUDIT_FORWARD_CLIENT_CERT=/tls/client.pem
# MCP_AUDIT_FORWARD_CLIENT_KEY=/tls/client-key.pem
